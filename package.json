{
  "name": "@nuxt/test-utils",
  "version": "4.3.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt/test-utils.git"
  },
  "description": "Test utilities for Nuxt",
  "license": "MIT",
  "type": "module",
  "types": "./dist/e2e.d.mts",
  "exports": {
    ".": "./src/e2e.ts",
    "./config": "./src/config.ts",
    "./e2e": "./src/e2e.ts",
    "./playwright": "./src/playwright.ts",
    "./experimental": "./src/experimental.ts",
    "./module": "./src/module.ts",
    "./runtime": "./src/runtime-utils/index.ts",
    "./vitest-environment": "./src/vitest-environment.ts",
    "./browser": "./src/browser/index.ts",
    "./browser/pure": "./src/browser/pure.ts",
    "./package.json": "./package.json"
  },
  "imports": {
    "#dirs": "./dirs.js"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./dist/e2e.d.mts"
      ],
      "config": [
        "./dist/config.d.mts"
      ],
      "e2e": [
        "./dist/e2e.d.mts"
      ],
      "playwright": [
        "./dist/playwright.d.mts"
      ],
      "experimental": [
        "./dist/experimental.d.mts"
      ],
      "module": [
        "./dist/module.d.mts"
      ],
      "runtime": [
        "./dist/runtime-utils/index.d.mts"
      ],
      "vitest-environment": [
        "./dist/vitest-environment.d.mts"
      ],
      "browser": [
        "./dist/browser/index.d.mts"
      ],
      "browser/pure": [
        "./dist/browser/pure.d.mts"
      ]
    }
  },
  "files": [
    "dist",
    "dirs.js"
  ],
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm test:types && pnpm test:unit && pnpm test:examples",
    "test:examples": "pnpm --filter '!@nuxt/test-utils' --filter '!example-app-cucumber' --filter '!example-app-jest' --filter '!example-app-bun' -r test && pnpm --filter example-app-cucumber -r test",
    "test:knip": "knip",
    "test:engines": "pnpm installed-check --no-workspaces --ignore-dev --ignore @cucumber/cucumber --ignore nuxt --ignore vitest",
    "test:types": "vue-tsc --noEmit && vitest --dir ./test/types --typecheck.only --run",
    "test:unit": "vitest --dir ./test/unit --run",
    "build": "tsdown",
    "prepack": "nuxt prepare && tsdown",
    "dev:prepare": "nuxt prepare && pnpm -r dev:prepare"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@nuxt/devtools-kit": "^3.4.2",
    "@nuxt/kit": "^4.6.1",
    "consola": "^3.4.2",
    "defu": "^6.1.7",
    "exsolve": "^1.1.3",
    "fake-indexeddb": "^6.2.5",
    "get-port-please": "^3.2.0",
    "magic-string": "^1.4.2",
    "ofetch": "^1.5.1",
    "oxc-walker": "^1.1.1",
    "package-manager-detector": "^1.9.0",
    "pathe": "^2.0.3",
    "perfect-debounce": "^2.1.0",
    "radix3": "^1.1.2",
    "std-env": "^4.3.0",
    "tinyexec": "^1.3.1",
    "ufo": "^1.6.4",
    "unplugin": "^3.4.0",
    "vitest-environment-nuxt": "workspace:*"
  },
  "devDependencies": {
    "@cucumber/cucumber": "13.2.1",
    "@jest/globals": "30.5.2",
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/schema": "4.6.1",
    "@oxc-project/types": "0.152.0",
    "@playwright/test": "1.63.0",
    "@testing-library/vue": "8.1.0",
    "@types/bun": "1.4.2",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.0",
    "@vitest/browser-playwright": "5.0.2",
    "@vue/test-utils": "2.5.1",
    "changelogen": "0.6.2",
    "compatx": "0.2.0",
    "eslint": "10.12.0",
    "h3": "1.15.11",
    "installed-check": "11.0.0",
    "knip": "6.39.0",
    "nitropack": "2.13.4",
    "nuxt": "4.6.1",
    "oxc-parser": "0.152.0",
    "pkg-pr-new": "0.0.88",
    "playwright-core": "1.63.0",
    "rollup": "4.64.0",
    "tsdown": "0.23.0",
    "typescript": "6.0.3",
    "unimport": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.2",
    "vue": "3.5.43",
    "vue-router": "5.3.1",
    "vue-tsc": "3.3.12"
  },
  "peerDependencies": {
    "@cucumber/cucumber": ">=11.0.0",
    "@jest/globals": ">=30.0.0",
    "@playwright/test": "^1.43.1",
    "@testing-library/vue": "^8.0.1",
    "@vue/test-utils": "^2.4.2",
    "h3": "^1.15.0 || ^2.0.0-0",
    "happy-dom": ">=20.0.11",
    "jsdom": ">=27.4.0",
    "nuxt": "^3.21.0 || ^4.0.0 || ^5.0.0-0",
    "playwright-core": "^1.43.1",
    "vitest": "^4.0.2 || ^5.0.0",
    "vue": "^3.5.0"
  },
  "peerDependenciesMeta": {
    "@cucumber/cucumber": {
      "optional": true
    },
    "@jest/globals": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "@testing-library/vue": {
      "optional": true
    },
    "@vitest/ui": {
      "optional": true
    },
    "@vue/test-utils": {
      "optional": true
    },
    "h3": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    },
    "jsdom": {
      "optional": true
    },
    "nuxt": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.0.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/e2e.mjs",
      "./config": "./dist/config.mjs",
      "./e2e": "./dist/e2e.mjs",
      "./playwright": "./dist/playwright.mjs",
      "./experimental": "./dist/experimental.mjs",
      "./module": "./dist/module.mjs",
      "./runtime": "./dist/runtime-utils/index.mjs",
      "./vitest-environment": "./dist/vitest-environment.mjs",
      "./browser": "./dist/browser/index.mjs",
      "./browser/pure": "./dist/browser/pure.mjs",
      "./package.json": "./package.json"
    }
  }
}
